<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>en</string>
		<key>CFBundleDisplayName</key>
		<string>${CLIENT_EXECUTABLE}</string>
		<key>CFBundleExecutable</key>
		<string>${CLIENT_EXECUTABLE}</string>
		<key>CFBundleIdentifier</key>
		<string>${IOS_BUNDLE_IDENTIFIER}</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>${CLIENT_EXECUTABLE}</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>${PROJECT_VERSION}</string>
		<key>CFBundleVersion</key>
		<string>${PROJECT_VERSION}</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- An empty launch screen uses the default background instead of the
		     legacy scaling mode, which would letterbox the app on newer devices. -->
		<key>UILaunchScreen</key>
		<dict/>
		<key>UIRequiredDeviceCapabilities</key>
		<array>
			<string>opengles-3</string>
		</array>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- Landscape-only apps must opt out of iPad multitasking -->
		<key>UIRequiresFullScreen</key>
		<true/>
		<!-- SDL references CoreBluetooth for wireless game controllers -->
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>DDNet uses Bluetooth to connect wireless game controllers.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>DDNet uses Bluetooth to connect wireless game controllers.</string>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Only exempt standard TLS encryption is used, declaring it avoids a
		     manual compliance answer in App Store Connect for every upload. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIFileSharingEnabled</key>
		<true/>
		<key>LSSupportsOpeningDocumentsInPlace</key>
		<true/>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>shareddocuments</string>
		</array>
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>
	</dict>
</plist>
